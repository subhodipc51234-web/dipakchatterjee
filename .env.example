# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed.

# Supabase project URL and anon (public) key — safe to expose to the
# client; every table they can touch is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — bypasses Row Level Security entirely. Server-only.
# Used exclusively so an anonymous citizen can submit a complaint (see
# utils/supabase/admin.ts for why). Never prefix with NEXT_PUBLIC_, never
# import from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: if set, /api/cron/purge-complaints requires this as a
# `Authorization: Bearer <secret>` header. If unset, that route is open
# (acceptable since the operation it performs is idempotent and low-risk
# — it only deletes complaints already past their expiration).
CRON_SECRET=

# Required for admin login: HMAC-signs the OTP session cookie
# (lib/otp-session.ts) and hashes login OTP codes before they're stored
# (lib/otp.ts) — never the raw code. Also available generally for any
# other server-side value that needs to be hashed/signed at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Optional: enables `npm run deploy:push` / `npm run notify:discord` (see
# scripts/notify-discord.js) to post a commit summary to a Discord
# channel after a local push. Create one via a Discord channel's
# Settings -> Integrations -> Webhooks. Leave unset to skip silently.
DISCORD_WEBHOOK_URL=

# --- Admin login OTP (2FA) ---
# On login, a 6-digit code is sent to BOTH the admin's email and phone
# at once (see lib/otp-login.ts). Configure email, SMS, or both — if
# NEITHER is set, the OTP challenge is skipped entirely rather than
# locking the admin out with a code that could never be delivered.
# Set the admin's own phone number from the dashboard's Settings ->
# Users & Access tab once at least one channel below is configured.

# Email, via Resend (https://resend.com) — a plain REST call, no SDK.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS — set SMS_PROVIDER to "fast2sms" or "twilio" and fill in that
# provider's own variables below. If SMS_PROVIDER is left blank, the
# first provider below with credentials set is used automatically.
SMS_PROVIDER=
# Fast2SMS (https://www.fast2sms.com) — India-focused SMS gateway.
FAST2SMS_API_KEY=
# Twilio (https://www.twilio.com) — international SMS gateway.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
